  "erros_no_escolhido": [
    {
      "id": "bat17-00",
      "rotulo": "sustenta",
      "p": 0.003,
      "frase": "O art. 60 da CLT diz que, para aumentar o horário de trabalho em atividades insalubres, é preciso pedir autorização antes das autoridades competentes.",
      "fonte": "CLT, Art. 60"
    },
    {
      "id": "bat17-01",
      "rotulo": "sustenta",
      "p": 0.006,
      "frase": "A exceção é que, quando a jornada é de 12 horas de trabalho e 36 horas de descanso seguidas, não é preciso pedir autorização antes.",
      "fonte": "CLT, Art. 60"
    },
    {
      "id": "bat17-02",
      "rotulo": "sustenta",
      "p": 0.002,
      "frase": "O art. 60 da CLT diz que, para aumentar o tempo de trabalho em atividades insalubres, é preciso pedir autorização das autoridades responsáveis por saúde no trabalho.",
      "fonte": "CLT, Art. 60"
    },
    {
      "id": "bat17-06",
      "rotulo": "sustenta",
      "p": 0.003,
      "frase": "O art. 462 também proíbe que as empresas restringam a liberdade dos funcionários de usar o seu salário como quiserem.",
      "fonte": "CLT, Art. 462"
    },
    {
      "id": "bat17-09",
      "rotulo": "sustenta",
      "p": 0.006,
      "frase": "O art. 462 também proíbe que as empresas obriguem os funcionários a usar o seu salário de uma forma específica.",
      "fonte": "CLT, Art. 462"
    },
    {
      "id": "bat17-10",
      "rotulo": "sustenta",
      "p": 0.333,
      "frase": "A remuneração do trabalho noturno urbano é maior em 20% do que a do diurno, conforme o CLT, Art. 73.",
      "fonte": "CLT, Art. 73"
    },
    {
      "id": "bat17-12",
      "rotulo": "sustenta",
      "p": 0.002,
      "frase": "O acréscimo de 20% é calculado sobre a hora diurna, conforme a LC 150/2015, Art. 14, § 2º.",
      "fonte": "LC 150/2015 (doméstico), Art. 14"
    },
    {
      "id": "bat17-14",
      "rotulo": "sustenta",
      "p": 0.396,
      "frase": "O trabalho noturno urbano é considerado aquele executado entre as 22 horas de um dia e as 5 horas do dia seguinte, conforme o CLT, Art. 73, § 2º.",
      "fonte": "CLT, Art. 73"
    },
    {
      "id": "bat17-19",
      "rotulo": "sustenta",
      "p": 0.192,
      "frase": "O tempo de serviço efetivo também conta quando o trabalhador estiver fora do trabalho por motivo de serviço militar ou acidente do trabalho.",
      "fonte": "CLT, Art. 4º"
    },
    {
      "id": "bat17-20",
      "rotulo": "contradiz",
      "p": 0.996,
      "frase": "O tempo que passa além da jornada normal, mesmo que seja um pouco mais, não é considerado hora extra, a menos que haja uma regra específica.",
      "fonte": "CLT, Art. 4º"
    },
    {
      "id": "bat17-22",
      "rotulo": "sustenta",
      "p": 0.455,
      "frase": "O tempo de serviço efetivo também conta quando o trabalhador estiver afastado por serviço militar ou acidente do trabalho.",
      "fonte": "CLT, Art. 4º"
    },
    {
      "id": "bat17-35",
      "rotulo": "sustenta",
      "p": 0.007,
      "frase": "O empregado pode ficar ausente nos dias em que tiver que fazer provas do vestibular para entrar em faculdade.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-36",
      "rotulo": "sustenta",
      "p": 0.355,
      "frase": "O empregado pode ficar ausente pelo tempo necessário se estiver participando de reunião oficial de órgão internacional em que o Brasil participe, na qualidade de representante de sindicato.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-37",
      "rotulo": "sustenta",
      "p": 0.538,
      "frase": "O empregado pode ficar ausente pelo tempo necessário para acompanhar a esposa ou companheira em até 6 consultas médicas ou exames durante a gravidez.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-45",
      "rotulo": "sustenta",
      "p": 0.005,
      "frase": "O empregado pode ficar ausente nos dias em que estiver fazendo provas do vestibular para entrar em faculdade.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-46",
      "rotulo": "sustenta",
      "p": 0.137,
      "frase": "O empregado pode ficar ausente pelo tempo que precisar, se estiver participando de reunião oficial de organismo internacional em que o Brasil participe, na qualidade de representante de sindicato.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-47",
      "rotulo": "sustenta",
      "p": 0.376,
      "frase": "O empregado pode ficar ausente para acompanhar sua esposa ou companheira em até 6 consultas médicas ou exames durante a gravidez.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-48",
      "rotulo": "sustenta",
      "p": 0.362,
      "frase": "O empregado pode ficar ausente pelo tempo necessário para acompanhar sua esposa ou companheira em até 6 consultas médicas ou em exames complementares durante o período de gravidez.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "bat17-51",
      "rotulo": "sustenta",
      "p": 0.656,
      "frase": "O seguro-desemprego para empregados domésticos demitidos sem justa causa tem valor de 1 salário-mínimo, por até 3 meses, conforme o Art. 26 da LC 150/2015.",
      "fonte": "LC 150/2015 (doméstico), Art. 26"
    },
    {
      "id": "bat17-54",
      "rotulo": "sustenta",
      "p": 0.001,
      "frase": "A falta de aviso prévio por parte do empregador dá ao empregado o direito aos salários correspondentes ao prazo do aviso.",
      "fonte": "LC 150/2015 (doméstico), Art. 23"
    },
    {
      "id": "bat17-55",
      "rotulo": "sustenta",
      "p": 0.002,
      "frase": "A falta de aviso prévio por parte do empregador dá ao empregado o direito aos salários correspondentes ao prazo do aviso, garantida sempre a integração desse período ao seu tempo de serviço.",
      "fonte": "LC 150/2015 (doméstico), Art. 23"
    },
    {
      "id": "bat17-56",
      "rotulo": "nao_trata",
      "p": 0.984,
      "frase": "A mulher grávida pode parar de trabalhar se o emprego prejudicar a gravidez, conforme o Art. 394 da CLT.",
      "fonte": "CLT, Art. 394"
    },
    {
      "id": "bat17-61",
      "rotulo": "sustenta",
      "p": 0.004,
      "frase": "A notificação do empregador relativa aos débitos com o FGTS interrompe o prazo prescricional, conforme o art. 23-A, § 1º, da Lei 8.036/1990.",
      "fonte": "Lei 8.036/1990 (FGTS), Art. 23-A"
    },
    {
      "id": "bat17-62",
      "rotulo": "sustenta",
      "p": 0.132,
      "frase": "Os resultados financeiros da Caixa Econômica Federal no período entre o repasse dos bancos e o depósito nas contas vinculadas destinar-se-ão à cobertura das despesas de administração do FGTS, conforme o art. 4º da Lei 8.036/1990.",
      "fonte": "Lei 8.036/1990 (FGTS), Art. 12"
    },
    {
      "id": "bat17-63",
      "rotulo": "sustenta",
      "p": 0.246,
      "frase": "A Caixa Econômica Federal passa a gerenciar as contas do FGTS (Fundo de Garantia do Tempo de Serviço) dentro de um ano, a partir da promulgação da Lei 8.036/1990, conforme o art. 12, caput, da mesma lei.",
      "fonte": "Lei 8.036/1990 (FGTS), Art. 12"
    },
    {
      "id": "bat17-65",
      "rotulo": "sustenta",
      "p": 0.303,
      "frase": "A conta vinculada será transferida para o banco escolhido pelo novo empregador, até que a centralização prevista no art. 12 seja concluída.",
      "fonte": "Lei 8.036/1990 (FGTS), Art. 12"
    },
    {
      "id": "adv-03",
      "rotulo": "contradiz",
      "p": 0.999,
      "frase": "O empregado pode faltar até 5 dias consecutivos por causa do casamento sem perder o salário.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "adv-05",
      "rotulo": "contradiz",
      "p": 0.997,
      "frase": "O empregado pode faltar um dia a cada 6 meses para doar sangue.",
      "fonte": "CLT, Art. 473"
    },
    {
      "id": "adv-07",
      "rotulo": "contradiz",
      "p": 0.875,
      "frase": "São acrescidos 5 dias de aviso prévio por ano de serviço na mesma empresa.",
      "fonte": "Lei 12.506/2011 (aviso prévio), Art. 1º"
    },
    {
      "id": "adv-17",
      "rotulo": "contradiz",
      "p": 0.962,
      "frase": "Na primeira solicitação do seguro-desemprego, basta ter recebido salários em 6 dos últimos 12 meses.",
      "fonte": "Lei 7.998/1990 (seguro-desemprego), Art. 3º"
    },
    {
      "id": "adv-30",
      "rotulo": "sustenta",
      "p": 0.056,
      "frase": "Na dispensa sem justa causa, o empregador deposita no FGTS 40% de todos os depósitos feitos durante o contrato.",
      "fonte": "Lei 8.036/1990 (FGTS), Art. 18"
    },
    {
      "id": "adv-35",
      "rotulo": "sustenta",
      "p": 0.111,
      "frase": "A multa do art. 477 é devida mesmo quando o vínculo de emprego só foi reconhecido na Justiça.",
      "fonte": "Súmula 462 do TST"
    }
  ],
