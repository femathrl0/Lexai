# Copie para .env e preencha. Segredos nunca entram no Git. Em produção, LEXAI_AMBIENTE=producao faz a partida
# falhar se algum segredo ainda estiver com o valor de exemplo.
LEXAI_AMBIENTE=desenvolvimento
LOG_NIVEL=INFO

POSTGRES_DB=lexai
POSTGRES_USER=lexai
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://lexai:troque-esta-senha@127.0.0.1:15432/lexai
# Banco legado (índices pgvector do lex_clt.ai), usado só com BUSCADOR=pgvector
DATABASE_URL_LEGADO=

REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:16379/0
RQ_TIMEOUT=900

MLFLOW_TRACKING_URI=http://127.0.0.1:15000

MINIO_ROOT_USER=lexai
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
# Vazio = o arquivo enviado passa por pasta temporária (backend e worker na mesma máquina)
MINIO_ENDPOINT=
MINIO_SEGURO=false
MINIO_BUCKET_ENTRADA=entrada
MINIO_BUCKET_ORIGINAIS=originais
# Prazo (dias) para exclusão automática de originais guardados com opt-in (RNF01)
PRAZO_GUARDA_DIAS=30
UPLOAD_MAX_MB=20
CORS_ORIGENS=

OLLAMA_HOST=http://127.0.0.1:11434
# qwen3:8b (Q4) — a q8_0 não cabe no orçamento de 16 GB (treino/relatorios/memoria_latencia_m4.md)
LLM_MODELO=qwen3:8b

# Worker: busca (local | pgvector), dispositivo dos modelos (vazio = automático; cpu | cuda | mps)
BUSCADOR=local
DISPOSITIVO=
LEXAI_PROMPT_ANALISE=
LEXAI_PROMPT_COMUNICACAO=
# Pasta do log de previsões (monitoramento); padrão dados/output/previsoes
LEXAI_PREVISOES_DIR=

# Sessões (RNF01)
SESSAO_MINUTOS=60
SEGREDO_SESSAO=troque-este-segredo
