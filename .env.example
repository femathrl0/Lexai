MINIO_BUCKET_ORIGINAIS=originais
# Prazo (dias) para exclusão automática de originais guardados com opt-in (RNF01)
PRAZO_GUARDA_DIAS=30

OLLAMA_HOST=http://127.0.0.1:11434
